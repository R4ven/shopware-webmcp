{% sw_extends '@Storefront/storefront/base.html.twig' %}

{#
    Bindet das B2B-WebMCP-Skript ein. Es nutzt die Command-Queue von SwagWebMcp
    (window.SwagWebMcp.push) und ist damit ladereihenfolge-unabhaengig – egal ob
    dieses Skript vor oder nach dem Basis-Skript ausgefuehrt wird.

    Beide Plugins ueberschreiben base_body_inner und rufen parent() auf, sodass
    sich die Skript-Tags additiv aneinanderreihen.
#}
{% block base_body_inner %}
    {{ parent() }}
    <script src="{{ asset('bundles/swagwebmcpb2b/swag-web-mcp-b2b.js') }}" defer></script>
{% endblock %}
